# ===================================================================
# Environment / Secrets — NEVER commit real .env files
# ===================================================================
.env
# Allow the template with placeholder values:
!.env.example

# ===================================================================
# IDE and System Files
# ===================================================================

# JetBrains IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Visual Studio Code
.vscode/

# macOS
.DS_Store


# ===================================================================
# Java Build Artifacts
# ===================================================================

# The main build output directory
/target/

# Compiled class files
*.class

# Log files
*.log

# Packaged applications
*.jar
*.war
*.ear

# Keep Gradle wrapper jar in VCS so CI can run ./gradlew.
!gradle/wrapper/gradle-wrapper.jar


# Java virtual machine crash logs
hs_err_pid*

# ===================================================================
# Gradle Build Artifacts
# ===================================================================

# Gradle local cache and daemon files (machine-specific, regenerated automatically)
.gradle/

# Gradle build output
/build/