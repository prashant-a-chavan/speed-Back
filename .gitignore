# ===================================================================
# IDE and System Files
# ===================================================================

# JetBrains IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Visual Studio Code
.vscode/

# macOS
.DS_Store


# ===================================================================
# Java Build Artifacts
# ===================================================================

# The main build output directory
/target/

# Compiled class files
*.class

# Log files
*.log

# Packaged applications
*.jar
*.war
*.ear


# Java virtual machine crash logs
hs_err_pid*

# ===================================================================
# Gradle Build Artifacts
# ===================================================================

# Gradle local cache and daemon files (machine-specific, regenerated automatically)
.gradle/

# Gradle build output
/build/

# ===================================================================
# Frontend Dependencies (Good practice if frontend is ever in the same repo)
# ===================================================================
/node_modules/
/frontend/node_modules/
/frontend/build/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*